model Store {
    id       String @id @default(cuid())
    name     String
    email    String @unique
    password String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt()

    sessions  Session[]
}

model Session {
    id      String @id
    storeId String
    store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

    expiresAt DateTime
    createdAt DateTime @default(now())
}
