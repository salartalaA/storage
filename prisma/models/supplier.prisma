model Supplier {
    id          String  @id @default(cuid())
    name        String
    phoneNumber String
    contactName String
    address     String
    isActive    Boolean @default(true)

    storeId String

    store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
